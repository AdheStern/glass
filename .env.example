# Glass — variables de entorno. Copiar a .env y completar.
# Nada aquí distingue "de verdad" a un cliente salvo estas líneas (§4.3).

# --- Identidad del despliegue -------------------------------------------------
SITE_SLUG=demo
SITE_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com          # se siembra como PROPIETARIO (pnpm db:seed)
OWNER_PASSWORD=glass-cambiar           # contraseña temporal del propietario
DEFAULT_CURRENCY=BOB
DEFAULT_LOCALE=es-BO
TZ=America/La_Paz

# --- Base de datos (Prisma, Postgres) ---------------------------------------
# DATABASE_URL: pooler en modo transacción (6543) para el runtime.
# DIRECT_URL:   pooler en modo sesión (5432) para migraciones y siembra.
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth del panel: Better Auth (ADR-04) ---------------------------------
# Genera el secreto con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000  # emisor OAuth / MCP; en prod, el dominio https

# --- Supabase: solo Storage (subida de imágenes, Fase 2) -----------------
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Correo (dev: Mailpit; prod: SMTP real) ------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Reportes: refresco nocturno de los agregados diarios (§18.3) -------------
# El cron de Coolify hace: curl -XPOST -H "Authorization: Bearer $CRON_SECRET" \
#   https://<dominio>/api/cron/rollup
CRON_SECRET=

# --- Respaldos (deploy/backup.sh, §4.1 · ver docs/respaldos.md) --------------
BACKUP_AGE_RECIPIENT=                  # clave pública age (age1...); la privada NO va en el VPS
BACKUP_REMOTE=                         # destino rclone, p. ej. r2:glass-backups/ferreteria-lopez
BACKUP_RETENTION_DAYS=30
