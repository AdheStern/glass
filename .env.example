# Glass — variables de entorno. Copiar a .env y completar.
# Nada aquí distingue "de verdad" a un cliente salvo estas líneas (§4.3).

# --- Identidad del despliegue -------------------------------------------------
SITE_SLUG=demo
SITE_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com          # se siembra como PROPIETARIO al primer arranque
DEFAULT_CURRENCY=BOB
DEFAULT_LOCALE=es-BO
TZ=America/La_Paz

# --- Supabase: base de datos (Prisma) --------------------------------------
# DATABASE_URL: pooler en modo transacción (6543) para el runtime.
# DIRECT_URL:   pooler en modo sesión (5432) para migraciones y siembra.
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase: auth y storage ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Correo (dev: Mailpit; prod: SMTP real) ------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
