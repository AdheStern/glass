// Glass — esquema de datos. Fuente: plan-maestro.html §5 y Apéndice A.
// Convenciones (§24.1): modelos PascalCase singular; tablas/columnas snake_case vía @@map;
// dinero Int en centavos con sufijo de moneda (…Bob); instantes …At, días …On;
// nada se borra: archivedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  PROPIETARIO
  ADMINISTRADOR
  EDITOR
  CAJERO
  ALMACEN
}

enum StockDisplay {
  EXACTO
  UMBRAL
  OCULTO
}

enum RoundingMode {
  NONE
  NEAREST_10
  NEAREST_50
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

enum MovementKind {
  INGRESO
  VENTA
  PEDIDO_ENTREGADO
  DEVOLUCION
  MERMA
  AJUSTE
  CARGA_INICIAL
}

enum OrderChannel {
  WHATSAPP
  POS
  WEB
}

enum StockCountStatus {
  ABIERTA
  CERRADA
  APLICADA
  CANCELADA
}

enum StockCountScope {
  TODO
  CATEGORIA
  LIBRE
}

enum OrderStatus {
  NUEVO
  CONFIRMADO
  PREPARADO
  ENTREGADO
  CANCELADO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// Los 10 bloques de §11.1.
enum BlockType {
  HERO
  BENTO
  PRODUCT_GRID
  TEXT_MEDIA
  GALLERY
  TESTIMONIALS
  FAQ
  MAP_CONTACT
  CTA_WHATSAPP
  POSTS
}

enum CashMovementKind {
  INGRESO
  RETIRO
  GASTO
}

enum SyncCommandStatus {
  APPLIED
  QUARANTINED
  REJECTED
}

// ===========================================================================
// Configuración del sitio
// ===========================================================================

model SiteSettings {
  id                   String       @id @default("singleton")
  name                 String
  logoPath             String?      @map("logo_path")
  currency             String       @default("BOB")
  locale               String       @default("es-BO")
  themePreset          String       @map("theme_preset")
  brandColor           String       @map("brand_color")
  cardPreset           String       @map("card_preset")
  density              String       @default("COMODA")
  homeLayout           String       @default("HERO") @map("home_layout")
  whatsappNumbers      Json         @default("[]") @map("whatsapp_numbers")
  socials              Json         @default("{}")
  address              Json?
  hours                Json         @default("{}")
  stockDisplay         StockDisplay @default(UMBRAL) @map("stock_display")
  lowStockThreshold    Int          @default(5) @map("low_stock_threshold")
  showSoldOut          Boolean      @default(true) @map("show_sold_out")
  roundingMode         RoundingMode @default(NONE) @map("rounding_mode")
  minOrderBob          Int?         @map("min_order_bob")
  orderMessageTemplate String?      @map("order_message_template")
  // POS (§16.2, §13.2)
  cashDifferenceThresholdBob Int    @default(500) @map("cash_difference_threshold_bob")
  maxCashierDiscountPercent  Int    @default(0) @map("max_cashier_discount_percent")
  receiptFooter        String?      @map("receipt_footer")
  // Caducidad del paquete de la tablet sin conexión (§17.2 regla 6)
  packageWarnHours     Int          @default(24) @map("package_warn_hours")
  packageBlockHours    Int          @default(72) @map("package_block_hours")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ===========================================================================
// Identidad — auth del panel con Better Auth (ADR-04) sobre este mismo Postgres.
// Estas tablas conservan el naming de la librería (excepción a §24.1): Better
// Auth habla con el cliente Prisma por nombre de campo, no de columna, y
// mantenerlas idénticas al generador evita deriva. El POS no pasa por acá.
// ===========================================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("CAJERO") // valores del enum Role (§6.3)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String    @default("")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// --- Servidor de autorización MCP (plugin mcp + cimd) ---------------------

model OauthClient {
  id                               String   @id @default(cuid())
  clientId                         String   @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?
  userId                           String?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     Json?
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?
  referenceId                      String?
  metadata                         Json?
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime?

  @@map("oauth_client")
}

model OauthResource {
  id                            String   @id @default(cuid())
  identifier                    String   @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?
  disabled                      Boolean?
  policyVersion                 Int?
  metadata                      Json?
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime?

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String    @id @default(cuid())
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime? @default(now())

  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                        String    @id @default(cuid())
  token                     String    @unique
  clientId                  String
  sessionId                 String?
  userId                    String
  referenceId               String?
  authorizationCodeId       String?
  resources                 Json?
  requestedUserInfoClaims   Json?
  scopes                    Json?
  expiresAt                 DateTime?
  revoked                   DateTime?
  rotatedAt                 DateTime?
  rotationReplayResponse    String?
  rotationReplayExpiresAt   DateTime?
  authTime                  DateTime?
  confirmation              Json?
  createdAt                 DateTime? @default(now())

  @@index([clientId])
  @@index([userId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String    @id @default(cuid())
  token                   String?   @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  refreshId               String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  Json?
  expiresAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  createdAt               DateTime? @default(now())

  @@index([clientId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String    @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  Json?
  createdAt               DateTime? @default(now())
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id @default(cuid())
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// Persona que cobra en la caja. Puede o no tener cuenta de usuario.
model Operator {
  id             String    @id @default(cuid())
  name           String
  pinHash        String    @map("pin_hash")
  role           Role      @default(CAJERO)
  userId         String?   @map("user_id")
  pinAttempts    Int       @default(0) @map("pin_attempts")
  pinLockedUntil DateTime? @map("pin_locked_until")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  cashSessions       CashSession[]
  salesAsOperator    Sale[]        @relation("SaleOperator")
  salesAuthorized    Sale[]        @relation("SaleAuthorizedBy")
  stockMovements     StockMovement[]
  cashMovements      CashMovement[]

  @@map("operator")
}

// Tablet o celular autorizado para la caja.
model Device {
  id            String    @id @default(cuid())
  name          String
  token         String    @unique
  lastSyncAt    DateTime? @map("last_sync_at")
  revokedAt     DateTime? @map("revoked_at")
  appVersion    String?   @map("app_version")
  // Sincronización sin conexión (§17.2): último seq de comando aplicado en orden.
  lastAppliedSeq Int      @default(0) @map("last_applied_seq")
  quarantinedAt DateTime? @map("quarantined_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  sales         Sale[]
  cashSessions  CashSession[]
  syncCommands  SyncCommand[]

  @@map("device")
}

// Código de emparejamiento de un dispositivo nuevo (6 dígitos, 10 min).
model DevicePairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("device_pairing_code")
}

// ===========================================================================
// Catálogo
// ===========================================================================

model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  parentId   String?   @map("parent_id")
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]
  discounts   Discount[]
  stockCounts StockCount[]

  @@index([parentId, position])
  @@map("category")
}

// Join explícito producto ↔ categoría (facilita la siembra por lotes).
model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category")
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  trackStock  Boolean   @default(true) @map("track_stock")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Mantenida por trigger (prisma/sql/search.sql). Prisma no la consulta; se usa por $queryRaw.
  searchTsv Unsupported("tsvector")? @map("search_tsv")

  categories ProductCategory[]
  variants   Variant[]
  images     ProductImage[]
  discounts  Discount[]

  @@index([isActive, archivedAt])
  @@map("product")
}

model Variant {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  sku          String?
  barcode      String?
  attributes   Json?
  basePriceBob Int       @map("base_price_bob")
  costBob      Int?      @map("cost_bob")
  minStock     Int       @default(0) @map("min_stock")
  position     Int       @default(0)
  archivedAt   DateTime? @map("archived_at")

  product    Product          @relation(fields: [productId], references: [id])
  movements  StockMovement[]
  stock      VariantStock?
  orderItems OrderItem[]
  saleItems  SaleItem[]
  countLines StockCountLine[]

  @@unique([barcode])
  @@index([productId])
  @@index([sku])
  @@map("variant")
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  path        String
  alt         String?
  position    Int     @default(0)
  blurDataUrl String? @map("blur_data_url") // marcador 8×8 (§12.1)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
  @@map("product_image")
}

model Discount {
  id         String        @id @default(cuid())
  name       String
  scope      DiscountScope
  percent    Int?
  amountBob  Int?          @map("amount_bob")
  categoryId String?       @map("category_id")
  startsAt   DateTime?     @map("starts_at")
  endsAt     DateTime?     @map("ends_at")
  isActive   Boolean       @default(true) @map("is_active")
  archivedAt DateTime?     @map("archived_at")

  category Category? @relation(fields: [categoryId], references: [id])
  products Product[]

  @@index([scope, isActive])
  @@map("discount")
}

// ===========================================================================
// Inventario — las existencias se derivan de este libro (ADR-05)
// ===========================================================================

model StockMovement {
  id         String       @id @default(cuid())
  variantId  String       @map("variant_id")
  kind       MovementKind
  qty        Int // negativo para salidas
  occurredAt DateTime     @map("occurred_at")
  sourceType String       @map("source_type")
  sourceId   String?      @map("source_id")
  note       String?
  operatorId String?      @map("operator_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  variant  Variant   @relation(fields: [variantId], references: [id])
  operator Operator? @relation(fields: [operatorId], references: [id])

  @@index([variantId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("stock_movement")
}

// Tabla-resumen mantenida por trigger AFTER INSERT ON stock_movement
// (prisma/sql/*.sql). NO es fuente de verdad: es caché para la lectura del catálogo.
model VariantStock {
  variantId      String    @id @map("variant_id")
  qty            Int       @default(0)
  lastMovementAt DateTime? @map("last_movement_at") // lo fija el trigger; alimenta el reporte de capital dormido (§14.4)
  updatedAt      DateTime  @default(now()) @map("updated_at")

  variant Variant @relation(fields: [variantId], references: [id])

  @@map("variant_stock")
}

// ===========================================================================
// Toma de inventario (§14.3) — congela el teórico, el cierre genera los AJUSTE
// ===========================================================================

model StockCount {
  id              String           @id @default(cuid())
  status          StockCountStatus @default(ABIERTA)
  scope           StockCountScope  @default(LIBRE)
  categoryId      String?          @map("category_id")
  note            String?
  createdByUserId String?          @map("created_by_user_id")
  frozenAt        DateTime         @default(now()) @map("frozen_at")
  closedAt        DateTime?        @map("closed_at")
  appliedAt       DateTime?        @map("applied_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  category Category?       @relation(fields: [categoryId], references: [id])
  lines    StockCountLine[]

  @@index([status, createdAt])
  @@map("stock_count")
}

model StockCountLine {
  id             String @id @default(cuid())
  stockCountId   String @map("stock_count_id")
  variantId      String @map("variant_id")
  theoreticalQty Int    @map("theoretical_qty") // saldo congelado al abrir
  countedQty     Int?   @map("counted_qty") // null = no contada (toma parcial)
  unitCostBob    Int?   @map("unit_cost_bob")

  stockCount StockCount @relation(fields: [stockCountId], references: [id])
  variant    Variant    @relation(fields: [variantId], references: [id])

  @@unique([stockCountId, variantId])
  @@index([variantId])
  @@map("stock_count_line")
}

// ===========================================================================
// Pedido (intención) — WhatsApp
// ===========================================================================

model Order {
  id            String       @id @default(cuid())
  folio         String       @unique // P-000184
  channel       OrderChannel @default(WHATSAPP)
  status        OrderStatus  @default(NUEVO)
  customerPhone String?      @map("customer_phone")
  customerName  String?      @map("customer_name")
  note          String?
  subtotalBob   Int          @map("subtotal_bob")
  discountBob   Int          @map("discount_bob")
  totalBob      Int          @map("total_bob")
  saleId        String?      @unique @map("sale_id")
  whatsappLabel String?      @map("whatsapp_label")
  source        String?      // de qué página vino (§9.2)
  statusChangedAt DateTime   @default(now()) @map("status_changed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  items OrderItem[]
  sale  Sale?       @relation(fields: [saleId], references: [id])

  @@index([status, createdAt])
  @@index([status, statusChangedAt])
  @@map("order")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  variantId     String  @map("variant_id")
  nameSnapshot  String  @default("") @map("name_snapshot") // nombre a la hora del pedido (§9.2)
  productSlug   String? @map("product_slug")
  qty           Int
  unitPriceBob  Int     @map("unit_price_bob") // precio efectivo congelado
  listPriceBob  Int     @default(0) @map("list_price_bob") // precio sin descuento
  discountBob   Int     @default(0) @map("discount_bob")
  note          String?

  order   Order   @relation(fields: [orderId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_item")
}

// ===========================================================================
// Venta (hecho) — trae su identidad desde el dispositivo
// ===========================================================================

model Sale {
  id                     String    @id @default(cuid())
  folio                  String    @unique // V-004512
  clientSaleId           String    @unique @map("client_sale_id") // UUID v7 del dispositivo
  deviceId               String    @map("device_id")
  seq                    Int
  operatorId             String    @map("operator_id")
  cashSessionId          String    @map("cash_session_id")
  authorizedByOperatorId String?   @map("authorized_by_operator_id")
  subtotalBob            Int       @map("subtotal_bob")
  discountBob            Int       @map("discount_bob")
  roundingBob            Int       @default(0) @map("rounding_bob")
  totalBob               Int       @map("total_bob")
  occurredAtDevice       DateTime  @map("occurred_at_device")
  receivedAtServer       DateTime  @default(now()) @map("received_at_server")
  priceSnapshotAt        DateTime  @map("price_snapshot_at")
  voidedAt               DateTime? @map("voided_at")
  voidReason             String?   @map("void_reason")

  device       Device      @relation(fields: [deviceId], references: [id])
  operator     Operator    @relation("SaleOperator", fields: [operatorId], references: [id])
  authorizedBy Operator?   @relation("SaleAuthorizedBy", fields: [authorizedByOperatorId], references: [id])
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  order        Order?

  @@unique([deviceId, seq])
  @@index([occurredAtDevice])
  @@index([cashSessionId])
  @@map("sale")
}

model SaleItem {
  id           String @id @default(cuid())
  saleId       String @map("sale_id")
  variantId    String @map("variant_id")
  qty          Int
  unitPriceBob Int    @map("unit_price_bob")
  discountBob  Int    @default(0) @map("discount_bob")

  sale    Sale    @relation(fields: [saleId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@map("sale_item")
}

model PaymentMethod {
  id            String    @id @default(cuid())
  label         String
  countsInDrawer Boolean  @default(true) @map("counts_in_drawer")
  position      Int       @default(0)
  archivedAt    DateTime? @map("archived_at")

  payments Payment[]

  @@map("payment_method")
}

model Payment {
  id        String @id @default(cuid())
  saleId    String @map("sale_id")
  methodId  String @map("method_id")
  amountBob Int    @map("amount_bob")

  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([saleId])
  @@map("payment")
}

// ===========================================================================
// Caja
// ===========================================================================

model CashSession {
  id           String    @id @default(cuid())
  operatorId   String    @map("operator_id")
  deviceId     String    @map("device_id")
  openedAt     DateTime  @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openingBob   Int       @map("opening_bob")
  countedBob   Int?      @map("counted_bob")
  expectedBob  Int?      @map("expected_bob")
  differenceBob Int?     @map("difference_bob")
  note         String?

  operator      Operator       @relation(fields: [operatorId], references: [id])
  device        Device         @relation(fields: [deviceId], references: [id])
  sales         Sale[]
  cashMovements CashMovement[]

  @@index([operatorId, openedAt])
  @@map("cash_session")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String           @map("cash_session_id")
  kind          CashMovementKind
  amountBob     Int              @map("amount_bob")
  reason        String?
  operatorId    String?          @map("operator_id")
  occurredAt    DateTime         @default(now()) @map("occurred_at")
  // Idempotencia del comando de la cola sin conexión (§17.2 regla 2).
  clientId      String?          @unique @map("client_id")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  operator    Operator?   @relation(fields: [operatorId], references: [id])

  @@index([cashSessionId])
  @@map("cash_movement")
}

// ===========================================================================
// Sincronización sin conexión (§17) — libro de comandos recibidos por lote
// ===========================================================================

model SyncCommand {
  id               String            @id @default(cuid())
  deviceId         String            @map("device_id")
  seq              Int
  kind             String // "SALE" | "VOID" | "CASH_MOVEMENT"
  clientId         String            @unique @map("client_id") // UUID v7 del navegador
  payload          Json
  status           SyncCommandStatus @default(APPLIED)
  error            String?
  occurredAtDevice DateTime          @map("occurred_at_device")
  receivedAtServer DateTime          @default(now()) @map("received_at_server")

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, seq])
  @@index([status])
  @@map("sync_command")
}

// ===========================================================================
// Contenido — CMS por bloques + blog
// ===========================================================================

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  status      ContentStatus @default(DRAFT)
  isHome      Boolean       @default(false) @map("is_home")
  metaTitle   String?       @map("meta_title")
  metaDesc    String?       @map("meta_desc")
  draftToken  String?       @unique @map("draft_token") // §11.3 vista previa por testigo
  publishedAt DateTime?     @map("published_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  blocks PageBlock[]

  @@map("page")
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  coverPath   String?       @map("cover_path")
  status      ContentStatus @default(DRAFT)
  authorName  String?       @map("author_name")
  tags        String[]      @default([])
  draftToken  String?       @unique @map("draft_token")
  publishedAt DateTime?     @map("published_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  blocks PageBlock[]

  @@map("post")
}

model PageBlock {
  id       String    @id @default(cuid())
  pageId   String?   @map("page_id")
  postId   String?   @map("post_id")
  type     BlockType
  position Int       @default(0)
  data     Json      @default("{}")

  page Page? @relation(fields: [pageId], references: [id])
  post Post? @relation(fields: [postId], references: [id])

  @@index([pageId, position])
  @@index([postId, position])
  @@map("page_block")
}

// ===========================================================================
// Transversal
// ===========================================================================

// Redirección 301 cuando cambia un slug (§20.2).
model SlugHistory {
  id        String   @id @default(cuid())
  entity    String // "product" | "category" | "page" | "post"
  oldSlug   String   @map("old_slug")
  newSlug   String   @map("new_slug")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([entity, oldSlug])
  @@map("slug_history")
}

// Lote de importación CSV (§19.2). Reversible durante 24 h.
model ImportBatch {
  id                String    @id @default(cuid())
  status            String    @default("APPLIED") // APPLIED | UNDONE
  createdByUserId   String?   @map("created_by_user_id")
  rowCount          Int       @map("row_count")
  createdCount      Int       @default(0) @map("created_count")
  updatedCount      Int       @default(0) @map("updated_count")
  createdProductIds Json      @default("[]") @map("created_product_ids")
  createdCategoryIds Json     @default("[]") @map("created_category_ids")
  createdAt         DateTime  @default(now()) @map("created_at")
  undoneAt          DateTime? @map("undone_at")

  @@index([createdAt])
  @@map("import_batch")
}

// Registro de auditoría (§21): cambios de precio, anulaciones, ajustes, altas.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String   @map("entity_id")
  actorType  String   @map("actor_type") // "user" | "operator" | "system"
  actorId    String?  @map("actor_id")
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_log")
}
