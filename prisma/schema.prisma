// Glass — esquema de datos. Fuente: plan-maestro.html §5 y Apéndice A.
// Convenciones (§24.1): modelos PascalCase singular; tablas/columnas snake_case vía @@map;
// dinero Int en centavos con sufijo de moneda (…Bob); instantes …At, días …On;
// nada se borra: archivedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  PROPIETARIO
  ADMINISTRADOR
  EDITOR
  CAJERO
  ALMACEN
}

enum StockDisplay {
  EXACTO
  UMBRAL
  OCULTO
}

enum RoundingMode {
  NONE
  NEAREST_10
  NEAREST_50
}

enum DiscountScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

enum MovementKind {
  INGRESO
  VENTA
  PEDIDO_ENTREGADO
  DEVOLUCION
  MERMA
  AJUSTE
  CARGA_INICIAL
}

enum OrderChannel {
  WHATSAPP
  POS
  WEB
}

enum OrderStatus {
  NUEVO
  CONFIRMADO
  PREPARADO
  ENTREGADO
  CANCELADO
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  HERO
  RICH_TEXT
  IMAGE
  GALLERY
  BENTO
  PRODUCT_GRID
  CATEGORY_CAROUSEL
  FAQ
  CTA
  MAP
  CONTACT
}

enum CashMovementKind {
  INGRESO
  RETIRO
  GASTO
}

// ===========================================================================
// Configuración del sitio
// ===========================================================================

model SiteSettings {
  id                   String       @id @default("singleton")
  name                 String
  logoPath             String?      @map("logo_path")
  currency             String       @default("BOB")
  locale               String       @default("es-BO")
  themePreset          String       @map("theme_preset")
  brandColor           String       @map("brand_color")
  cardPreset           String       @map("card_preset")
  density              String       @default("COMODA")
  homeLayout           String       @default("HERO") @map("home_layout")
  whatsappNumbers      Json         @default("[]") @map("whatsapp_numbers")
  socials              Json         @default("{}")
  address              Json?
  hours                Json         @default("{}")
  stockDisplay         StockDisplay @default(UMBRAL) @map("stock_display")
  lowStockThreshold    Int          @default(5) @map("low_stock_threshold")
  showSoldOut          Boolean      @default(true) @map("show_sold_out")
  roundingMode         RoundingMode @default(NONE) @map("rounding_mode")
  minOrderBob          Int?         @map("min_order_bob")
  orderMessageTemplate String?      @map("order_message_template")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ===========================================================================
// Identidad
// ===========================================================================

// Perfil de la aplicación ligado a un usuario de Supabase Auth (auth.users.id).
// Sin FK al schema `auth`: solo se guarda el uuid.
model UserProfile {
  id         String    @id @default(cuid())
  authUserId String    @unique @map("auth_user_id")
  email      String    @unique
  name       String?
  role       Role      @default(CAJERO)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("user_profile")
}

// Persona que cobra en la caja. Puede o no tener cuenta de usuario.
model Operator {
  id         String    @id @default(cuid())
  name       String
  pinHash    String    @map("pin_hash")
  role       Role      @default(CAJERO)
  userId     String?   @map("user_id")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  cashSessions       CashSession[]
  salesAsOperator    Sale[]        @relation("SaleOperator")
  salesAuthorized    Sale[]        @relation("SaleAuthorizedBy")
  stockMovements     StockMovement[]
  cashMovements      CashMovement[]

  @@map("operator")
}

// Tablet o celular autorizado para la caja.
model Device {
  id         String    @id @default(cuid())
  name       String
  token      String    @unique
  lastSyncAt DateTime? @map("last_sync_at")
  revokedAt  DateTime? @map("revoked_at")
  appVersion String?   @map("app_version")
  createdAt  DateTime  @default(now()) @map("created_at")

  sales        Sale[]
  cashSessions CashSession[]

  @@map("device")
}

// Código de emparejamiento de un dispositivo nuevo (6 dígitos, 10 min).
model DevicePairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("device_pairing_code")
}

// ===========================================================================
// Catálogo
// ===========================================================================

model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  parentId   String?   @map("parent_id")
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")

  parent    Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryTree")
  products  ProductCategory[]
  discounts Discount[]

  @@index([parentId, position])
  @@map("category")
}

// Join explícito producto ↔ categoría (facilita la siembra por lotes).
model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category")
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  trackStock  Boolean   @default(true) @map("track_stock")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Mantenida por trigger (prisma/sql/search.sql). Prisma no la consulta; se usa por $queryRaw.
  searchTsv Unsupported("tsvector")? @map("search_tsv")

  categories ProductCategory[]
  variants   Variant[]
  images     ProductImage[]
  discounts  Discount[]

  @@index([isActive, archivedAt])
  @@map("product")
}

model Variant {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  sku          String?
  barcode      String?
  attributes   Json?
  basePriceBob Int       @map("base_price_bob")
  costBob      Int?      @map("cost_bob")
  minStock     Int       @default(0) @map("min_stock")
  position     Int       @default(0)
  archivedAt   DateTime? @map("archived_at")

  product   Product         @relation(fields: [productId], references: [id])
  movements StockMovement[]
  stock     VariantStock?
  orderItems OrderItem[]
  saleItems  SaleItem[]

  @@unique([barcode])
  @@index([productId])
  @@index([sku])
  @@map("variant")
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  path        String
  alt         String?
  position    Int     @default(0)
  blurDataUrl String? @map("blur_data_url") // marcador 8×8 (§12.1)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
  @@map("product_image")
}

model Discount {
  id         String        @id @default(cuid())
  name       String
  scope      DiscountScope
  percent    Int?
  amountBob  Int?          @map("amount_bob")
  categoryId String?       @map("category_id")
  startsAt   DateTime?     @map("starts_at")
  endsAt     DateTime?     @map("ends_at")
  isActive   Boolean       @default(true) @map("is_active")
  archivedAt DateTime?     @map("archived_at")

  category Category? @relation(fields: [categoryId], references: [id])
  products Product[]

  @@index([scope, isActive])
  @@map("discount")
}

// ===========================================================================
// Inventario — las existencias se derivan de este libro (ADR-05)
// ===========================================================================

model StockMovement {
  id         String       @id @default(cuid())
  variantId  String       @map("variant_id")
  kind       MovementKind
  qty        Int // negativo para salidas
  occurredAt DateTime     @map("occurred_at")
  sourceType String       @map("source_type")
  sourceId   String?      @map("source_id")
  note       String?
  operatorId String?      @map("operator_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  variant  Variant   @relation(fields: [variantId], references: [id])
  operator Operator? @relation(fields: [operatorId], references: [id])

  @@index([variantId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("stock_movement")
}

// Tabla-resumen mantenida por trigger AFTER INSERT ON stock_movement
// (prisma/sql/*.sql). NO es fuente de verdad: es caché para la lectura del catálogo.
model VariantStock {
  variantId String   @id @map("variant_id")
  qty       Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at")

  variant Variant @relation(fields: [variantId], references: [id])

  @@map("variant_stock")
}

// ===========================================================================
// Pedido (intención) — WhatsApp
// ===========================================================================

model Order {
  id            String       @id @default(cuid())
  folio         String       @unique // P-000184
  channel       OrderChannel @default(WHATSAPP)
  status        OrderStatus  @default(NUEVO)
  customerPhone String?      @map("customer_phone")
  customerName  String?      @map("customer_name")
  note          String?
  subtotalBob   Int          @map("subtotal_bob")
  discountBob   Int          @map("discount_bob")
  totalBob      Int          @map("total_bob")
  saleId        String?      @unique @map("sale_id")
  whatsappLabel String?      @map("whatsapp_label")
  source        String?      // de qué página vino (§9.2)
  statusChangedAt DateTime   @default(now()) @map("status_changed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  items OrderItem[]
  sale  Sale?       @relation(fields: [saleId], references: [id])

  @@index([status, createdAt])
  @@index([status, statusChangedAt])
  @@map("order")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  variantId     String  @map("variant_id")
  nameSnapshot  String  @default("") @map("name_snapshot") // nombre a la hora del pedido (§9.2)
  productSlug   String? @map("product_slug")
  qty           Int
  unitPriceBob  Int     @map("unit_price_bob") // precio efectivo congelado
  listPriceBob  Int     @default(0) @map("list_price_bob") // precio sin descuento
  discountBob   Int     @default(0) @map("discount_bob")
  note          String?

  order   Order   @relation(fields: [orderId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_item")
}

// ===========================================================================
// Venta (hecho) — trae su identidad desde el dispositivo
// ===========================================================================

model Sale {
  id                     String    @id @default(cuid())
  folio                  String    @unique // V-004512
  clientSaleId           String    @unique @map("client_sale_id") // UUID v7 del dispositivo
  deviceId               String    @map("device_id")
  seq                    Int
  operatorId             String    @map("operator_id")
  cashSessionId          String    @map("cash_session_id")
  authorizedByOperatorId String?   @map("authorized_by_operator_id")
  subtotalBob            Int       @map("subtotal_bob")
  discountBob            Int       @map("discount_bob")
  roundingBob            Int       @default(0) @map("rounding_bob")
  totalBob               Int       @map("total_bob")
  occurredAtDevice       DateTime  @map("occurred_at_device")
  receivedAtServer       DateTime  @default(now()) @map("received_at_server")
  priceSnapshotAt        DateTime  @map("price_snapshot_at")
  voidedAt               DateTime? @map("voided_at")
  voidReason             String?   @map("void_reason")

  device       Device      @relation(fields: [deviceId], references: [id])
  operator     Operator    @relation("SaleOperator", fields: [operatorId], references: [id])
  authorizedBy Operator?   @relation("SaleAuthorizedBy", fields: [authorizedByOperatorId], references: [id])
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  order        Order?

  @@unique([deviceId, seq])
  @@index([occurredAtDevice])
  @@index([cashSessionId])
  @@map("sale")
}

model SaleItem {
  id           String @id @default(cuid())
  saleId       String @map("sale_id")
  variantId    String @map("variant_id")
  qty          Int
  unitPriceBob Int    @map("unit_price_bob")
  discountBob  Int    @default(0) @map("discount_bob")

  sale    Sale    @relation(fields: [saleId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@map("sale_item")
}

model PaymentMethod {
  id            String    @id @default(cuid())
  label         String
  countsInDrawer Boolean  @default(true) @map("counts_in_drawer")
  position      Int       @default(0)
  archivedAt    DateTime? @map("archived_at")

  payments Payment[]

  @@map("payment_method")
}

model Payment {
  id        String @id @default(cuid())
  saleId    String @map("sale_id")
  methodId  String @map("method_id")
  amountBob Int    @map("amount_bob")

  sale   Sale          @relation(fields: [saleId], references: [id])
  method PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([saleId])
  @@map("payment")
}

// ===========================================================================
// Caja
// ===========================================================================

model CashSession {
  id           String    @id @default(cuid())
  operatorId   String    @map("operator_id")
  deviceId     String    @map("device_id")
  openedAt     DateTime  @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openingBob   Int       @map("opening_bob")
  countedBob   Int?      @map("counted_bob")
  expectedBob  Int?      @map("expected_bob")
  differenceBob Int?     @map("difference_bob")
  note         String?

  operator      Operator       @relation(fields: [operatorId], references: [id])
  device        Device         @relation(fields: [deviceId], references: [id])
  sales         Sale[]
  cashMovements CashMovement[]

  @@index([operatorId, openedAt])
  @@map("cash_session")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String           @map("cash_session_id")
  kind          CashMovementKind
  amountBob     Int              @map("amount_bob")
  reason        String?
  operatorId    String?          @map("operator_id")
  occurredAt    DateTime         @default(now()) @map("occurred_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  operator    Operator?   @relation(fields: [operatorId], references: [id])

  @@index([cashSessionId])
  @@map("cash_movement")
}

// ===========================================================================
// Contenido — CMS por bloques + blog
// ===========================================================================

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  status      ContentStatus @default(DRAFT)
  metaTitle   String?       @map("meta_title")
  metaDesc    String?       @map("meta_desc")
  publishedAt DateTime?     @map("published_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  blocks PageBlock[]

  @@map("page")
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  coverPath   String?       @map("cover_path")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  blocks PageBlock[]

  @@map("post")
}

model PageBlock {
  id       String    @id @default(cuid())
  pageId   String?   @map("page_id")
  postId   String?   @map("post_id")
  type     BlockType
  position Int       @default(0)
  data     Json      @default("{}")

  page Page? @relation(fields: [pageId], references: [id])
  post Post? @relation(fields: [postId], references: [id])

  @@index([pageId, position])
  @@index([postId, position])
  @@map("page_block")
}

// ===========================================================================
// Transversal
// ===========================================================================

// Redirección 301 cuando cambia un slug (§20.2).
model SlugHistory {
  id        String   @id @default(cuid())
  entity    String // "product" | "category" | "page" | "post"
  oldSlug   String   @map("old_slug")
  newSlug   String   @map("new_slug")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([entity, oldSlug])
  @@map("slug_history")
}

// Lote de importación CSV (§19.2). Reversible durante 24 h.
model ImportBatch {
  id                String    @id @default(cuid())
  status            String    @default("APPLIED") // APPLIED | UNDONE
  createdByUserId   String?   @map("created_by_user_id")
  rowCount          Int       @map("row_count")
  createdCount      Int       @default(0) @map("created_count")
  updatedCount      Int       @default(0) @map("updated_count")
  createdProductIds Json      @default("[]") @map("created_product_ids")
  createdCategoryIds Json     @default("[]") @map("created_category_ids")
  createdAt         DateTime  @default(now()) @map("created_at")
  undoneAt          DateTime? @map("undone_at")

  @@index([createdAt])
  @@map("import_batch")
}

// Registro de auditoría (§21): cambios de precio, anulaciones, ajustes, altas.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String   @map("entity_id")
  actorType  String   @map("actor_type") // "user" | "operator" | "system"
  actorId    String?  @map("actor_id")
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_log")
}
